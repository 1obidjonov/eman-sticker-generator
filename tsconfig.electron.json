{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "noEmit": false
  },
  "include": [
    "src/main/**/*.ts",
    "src/core/**/*.ts",
    "src/shared/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["dist", "node_modules", "src/preload.ts", "src/renderer", "tests"]
}
